{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "allowJs": true,
        "experimentalDecorators": true,
        "declaration": true,
        "esModuleInterop": true,
        "strict": true,
        "lib": ["decorators", "dom", "es5", "scripthost", "es2015.collection"],
        "types": ["node", "vitest/globals"],
        "outDir": "./lib"
    },
    "exclude": ["node_modules", "**/*.test.ts", "**/dist/*", "**/lib/*"]
}
